# HOSTNAME is informational only; the server listens on all interfaces on PORT.
HOSTNAME=localhost
PORT=3000
NODE_ENV=development

# Public base URL of this server, used to build password-reset links (required in production)
APP_URL=http://localhost:3000
# Comma-separated list of origins allowed to make credentialed CORS requests.
# Defaults to http://localhost:8080,http://localhost:3000 outside production; no CORS in production unless set.
CORS_ORIGINS=http://localhost:8080,http://localhost:3000
# Express "trust proxy" setting: loopback (default), true, false, a hop count, or comma-separated IPs/subnets
TRUST_PROXY=loopback
# Set to true to disable auth rate limiting (test suites only)
RATE_LIMIT_DISABLED=false
# Set to "log" to print emails to the console instead of sending them via Mailgun
MAIL_TRANSPORT=

DB_URI="mongodb://localhost:27017/debe"
# MongoDB server selection timeout (ms); the server exits with code 1 if the DB is unreachable at startup
DB_CONNECT_TIMEOUT=10000
# Not read by the code: put production/Atlas connection strings in DB_URI
DB_PROD="mongodb+srv://<mongodb_srv_user>:<mongodb_srv_pass>@<mongodb_srv_host>/<dbname>?retryWrites=true&w=majority"

SESSION_EXPIRATION=604800000
# Required, at least 32 characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET="<replace_with_a_strong_session_secret>"

# Lifetimes in milliseconds
JWT_EXPIRY=3600000
JWT_REFRESH_EXPIRY=2592000000
# Required, at least 32 characters
JWT_SECRET="<replace_with_a_strong_JWT_session_secret>"

# Deployment
DEPLOYMENT_HOST="<deployment_host>"
DEPLOYMENT_USER="<deployment_user>"
DEPLOYMENT_KEY="<deployment_ssh_key_path>"

# GOOGLE API
GOOGLE_API_KEY="<replace_with_google_api_key>"

# MailGun
MG_APIKEY="<replace_with_mailgun_api_key>"
MG_DOMAIN="<replace_with_mailgun_host>"
# Mailgun API base URL; only needed for EU-region domains: https://api.eu.mailgun.net
MG_URL=
