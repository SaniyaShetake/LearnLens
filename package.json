    "nodemon": "^3.1.14",
    "pm2": "^7.0.4",
    "supertest": "^7.3.0"
  },
  "resolutions": {
    "exceljs/uuid": "^11.1.1",
    "pm2/js-yaml": "^4.3.2"
  }
