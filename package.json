  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "connect-mongo": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "cross-env": "^10.1.0",
    "debug": "^4.4.3",
    "dotenv": "^18.0.4",
    "exceljs": "^4.4.0",
    "express": "^4.22.1",
    "express-rate-limit": "^8.7.0",
    "express-session": "^1.19.0",
    "form-data": "^4.0.6",
    "hbs": "^4.3.1",
    "http-errors": "^2.0.1",
    "jsonwebtoken": "^9.0.3",
    "mailgun.js": "^14.0.1",
    "mongodb": "~6.20.0",
    "mongoose": "^8.24.4",
    "morgan": "^1.10.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "serve-favicon": "^2.5.1"
