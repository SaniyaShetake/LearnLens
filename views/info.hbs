<html lang="en">

<head>
  <meta charset="utf-8" />
  <link rel="icon" href="/favicon.ico" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="theme-color" content="#000000" />
  <meta name="description" content="STORM web application created with React.js" />
  <title>Tcherly</title>
  <link href="/styles/reset-password.css" rel="stylesheet" />
  <style>
    footer {
      background: #1f1f1f;
      padding: 1rem;
      color: #fff;
    }

    @media (max-width: 991.98px) {
      footer {
        font-size: 0.8rem;
      }
    }

    footer .img-logo {
      max-height: 150px;
    }

    @media (max-width: 767.98px) {
      footer .img-logo {
        max-height: 80px;
      }
    }

    footer a.footer-link {
      color: #c2f3ff;
    }

    footer .copyright {
      text-align: justify;
      text-align-last: center;
    }

    @media (max-width: 575.98px) {
      footer .copyright {
        text-align: center;
      }
    }
  </style>
  {{!
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.0/dist/css/bootstrap.min.css"
