</head>

<body><noscript>You need to enable JavaScript to run this app.</noscript>
  <div id="root">
    <header class="">
      <nav class="navbar navbar-expand-sm navbar-light bg-light"><a href="/" class="navbar-brand">Feedback</a><button
          aria-controls="navbar-collapse" type="button" aria-label="Toggle navigation"
          class="navbar-toggler collapsed"><span class="navbar-toggler-icon"></span></button>
        <div class="navbar-collapse collapse" id="navbar-collapse">
          <div class="ml-auto navbar-nav"><a class="nav-link" href="/register">Signup</a><a class="nav-link"
              href="/">Login</a></div>
        </div>
      </nav>
    </header>
    <main>
      <div class="container" style="height: calc(100% - 70px - 53px);">
        <div class="row align-content-center" style="height: 100%; user-select: none !important;">
          <div class="col-12 col-md-3 d-flex justify-content-center justify-content-md-end">
            {{#if success}}
            <img class="img-fluid" src="/tick.svg" alt="" />
            {{else}}
            {{#if info}}
            <img class="img-fluid" src="/info.svg" alt="" />
            {{else}}
            <img class="img-fluid" src="/close.svg" alt="" />
            {{/if}}
            {{/if}}
          </div>
          <div class="col-12 col-md-9 d-flex justify-content-center px-3 align-items-center"
            style="font-size: 2.25rem;">
            {{#if message}}
            {{message}}
            {{/if}}
          </div>
          <div class="col-12 text-center">
            <a class="btn btn-info" href="/" id="go-back-btn">Go back</a>
          </div>
        </div>
      </div>
    </main>
    <footer>
