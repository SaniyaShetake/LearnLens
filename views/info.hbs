              target="_blank" rel="noopener noreferrer external"><img src="/et-logo.png"
                alt="Interdisciplinary Programme in Education Technology." class="img-fluid img-logo" /></a></div>
          <div class="col-xl-5 col-lg-6 col-md-7 mb-3 mb-md-0">
            <div class="d-flex h-100 justify-content-center">
              <div class="contact-us text-sm-left text-justify">
                <div class="text-left mt-4 mt-sm-0">Contact us</div>
                <table class="table table-borderless text-light mb-0">
