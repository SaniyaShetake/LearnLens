<html lang="en">

<head>
  <meta charset="utf-8">
  <link rel="icon" href="/favicon.ico">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="theme-color" content="#000000">
  <meta name="description" content="STORM web application created with React.js">
  <title>Tcherly</title>
  <link href="/styles/reset-password.css" rel="stylesheet">
  <style>
    footer {
      background: #1f1f1f;
      padding: 1rem;
      color: #fff;
    }

    @media (max-width: 991.98px) {
      footer {
        font-size: 0.8rem;
      }
    }

    footer .img-logo {
      max-height: 150px;
    }

    @media (max-width: 767.98px) {
      footer .img-logo {
        max-height: 80px;
      }
    }

    footer a.footer-link {
      color: #c2f3ff;
    }

    footer .copyright {
      text-align: justify;
      text-align-last: center;
    }

    @media (max-width: 575.98px) {
      footer .copyright {
        text-align: center;
      }
    }
  </style>
</head>

<body><noscript>You need to enable JavaScript to run this app.</noscript>
  <div id="root">
    <header class="">
      <nav class="navbar navbar-expand-sm navbar-light bg-light"><a href="/" class="navbar-brand">Feedback</a><button
          aria-controls="navbar-collapse" type="button" aria-label="Toggle navigation"
          class="navbar-toggler collapsed"><span class="navbar-toggler-icon"></span></button>
        <div class="navbar-collapse collapse" id="navbar-collapse">
          <div class="ml-auto navbar-nav"><a class="nav-link" href="/register">Signup</a><a class="nav-link"
              href="/">Login</a></div>
        </div>
      </nav>
    </header>
    <main>
      <div class="container h-100">
        <div class="row h-100 justify-content-center align-items-center">
          <div class="col-sm-12 col-md-10 col-lg-6">
            <div class="card">
              <div class="card-body forgot-pass">
                <div class="text-center pt-3">
                  <h5>Reset your password</h5>
                  <p class="px-5 mb-4 text-muted" style="font-size: 0.9rem;"></p>
                </div>
                <form action="/password/reset/{{token}}" method="POST" autocomplete="off">
                  <input type="hidden" name="_csrf" value="{{csrfToken}}">
                  <div class="form-group">
                    <label for="new-password">New Password</label>
                    <input autocomplete="off" type="password" class="form-control" name="password" id="new-password">
                  </div>
                  <div class="form-group">
                    <label for="confirm-new-password">Confirm Password</label>
                    <input autocomplete="off" type="password" class="form-control" name="confirm_password"
                      id="confirm-new-password">
                  </div>

                  <div class="form-group">
                    <div class="custom-control custom-checkbox">
                      <input type="checkbox" class="custom-control-input" id="show-password">
                      <label class="custom-control-label" for="show-password">Show Password</label>
                    </div>
                  </div>

                  {{#if message}}
                  <div id="error-div" class="alert alert-danger" role="alert">
                    {{message}}
                  </div>
                  {{else}}
                  <div id="error-div" class="alert alert-danger d-none" role="alert">
                  </div>
                  {{/if}}

                  <div class="text-center">
                    <button id="form-submit" type="submit" class="btn btn-primary"
                      id="forgot-form-submit">Confirm</button>
                  </div>
                </form>
              </div>
            </div>
          </div>
        </div>
      </div>
    </main>
    <footer>
      <div class="container">
        <div class="row justify-content-center justify-content-md-between">
          <div class="col-xl-3 col-lg-4 col-md-3 col-sm-5 text-center"><a href="http://www.et.iitb.ac.in/"
              target="_blank" rel="noopener noreferrer external"><img src="/et-logo.png"
                alt="Interdisciplinary Programme in Education Technology." class="img-fluid img-logo" /></a></div>
          <div class="col-xl-5 col-lg-6 col-md-7 mb-3 mb-md-0">
            <div class="d-flex h-100 justify-content-center">
              <div class="contact-us text-sm-left text-justify">
                <div class="text-left mt-4 mt-sm-0">Contact us</div>
                <table class="table table-borderless text-light mb-0">
                  <thead>
                    <tr>
                      <td class="p-0"> </td>
                      <td class="p-0"> </td>
                      <td class="p-0"> </td>
                      <td class="p-0"> </td>
                    </tr>
                  </thead>
                  <tbody>
                    <tr>
                      <td class="p-0"><a class="footer-link"
                          href="mailto:pankajchavan@iitb.ac.in?cc=rmitra@iitb.ac.in,localhoax0@gmail.com&amp;subject=Tcherly Contact"><i
                            class="fas fa-envelope"></i></a></td>
                      <td class="px-2 py-0"><a class="footer-link" href="https://www.pankajchavan.me/" target="_blank"
                          rel="noopener no">Pankaj Chavan</a>&nbsp;</td>
                      <td class="p-0">Research
                        Scholar</td>
                      <td class="p-0"> </td>
                    </tr>
                    <tr>
                      <td class="p-0"><a class="footer-link"
                          href="mailto:rmitra@iitb.ac.in?cc=pankajchavan@iitb.ac.in,localhoax0@gmail.com&amp;subject=Tcherly Contact"><i
                            class="fas fa-envelope"></i></a></td>
                      <td class="px-2 py-0"><a class="footer-link" href="https://sites.google.com/site/mitrares001/"
                          target="_blank" rel="noopener no">Ritayan Mitra</a>&nbsp;</td>
                      <td class="p-0">Faculty</td>
                      <td class="p-0"> </td>
                    </tr>
                    <tr>
                      <td class="p-0"><a class="footer-link"
                          href="mailto:localhoax0@gmail.com?cc=pankajchavan@iitb.ac.in,rmitra@iitb.ac.in&amp;subject=Tcherly Contact"><i
                            class="fas fa-envelope"></i></a></td>
                      <td class="px-2 py-0"><a class="footer-link"
                          href="https://www.linkedin.com/in/bhupender-singh-maan" target="_blank"
                          rel="author no">Bhupender Singh Maan</a>&nbsp;</td>
                      <td class="p-0">Software Developer</td>
                      <td class="p-0">
                      </td>
                    </tr>
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>
        <div class="copyright mt-3">
          <div class="mx-auto">Copyright © 2020-2021
            <a href="http://www.et.iitb.ac.in/" target="_blank" rel="author noreferrer external"
              class="footer-link">IDP-ET, IIT Bombay</a>. All Rights Reserved.
          </div>
        </div>
      </div>
    </footer>
  </div>

</body>
<script>
  const nP = document.getElementById("new-password");
  const cNP = document.getElementById("confirm-new-password");
  const errorDiv = document.getElementById("error-div");
  const fS = document.getElementById('form-submit')

  // Same policy as the server: 8-32 characters, any characters allowed
  const isValidPassword = (value) => typeof value === "string" && value.length >= 8 && value.length <= 32;

  const resetErrorDiv = () => {
    if (errorDiv) {
      errorDiv.innerText = ""
      errorDiv.classList.add('d-none')
    }
  }
  const setErrorMessage = msg => {
    if (errorDiv) {
      errorDiv.innerText = msg
      errorDiv.classList.remove('d-none')
    }
  }

  function handleErrorDiv(reset = false) {
    if (reset) {

      resetErrorDiv()
      nP.classList.remove('is-invalid')
      cNP.classList.remove('is-invalid')


      if (isValidPassword(nP.value)) {
        nP.classList.add('is-valid')
        cNP.classList.add('is-valid')
      } else {
        nP.classList.add('is-invalid')
        cNP.classList.add('is-invalid')
        setErrorMessage("Choose a strong password between 8-32 characters.")
      }

    } else {
      setErrorMessage("Passwords do not match, try again.")
      nP.classList.add('is-invalid')
      cNP.classList.add('is-invalid')

    }
  }
  if (nP && cNP && errorDiv) {
    nP.onkeyup = function (e) {
      if (cNP.value === "") {
        nP.value = e.target.value;
        return;
      }
      handleErrorDiv(e.target.value === cNP.value);
    };
    cNP.onkeyup = function (e) {
      handleErrorDiv(e.target.value === nP.value);
    };
  }

  const showPasswordCheck = document.getElementById('show-password')
  let showPassword = false
  if (showPasswordCheck) {

    showPasswordCheck.onclick = function (e) {
      showPassword = !showPassword
      nP.setAttribute('type', showPassword ? 'text' : 'password')
      cNP.setAttribute('type', showPassword ? 'text' : 'password')
    }
  }

  fS.onclick = function (e) {
    resetErrorDiv()
    let error = ""
    if (nP.value && nP.value.length > 0)
      if (nP.value === cNP.value) {
        if (isValidPassword(nP.value) && isValidPassword(cNP.value)) {
          return
        }
        error = "Choose a strong password between 8-32 characters.";
      } else {
        error = "Passwords do not match, try again.";
      }
    else {
      error = "Please provide a valid password between 8-32 characters.";
    }
    setErrorMessage(error)
    e.preventDefault()
  }

</script>

</html>