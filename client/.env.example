# Vite dev server settings (only used by `yarn start` / `yarn dev`; the port is fixed to 8080
# in vite.config.js and /api/ is proxied to the backend).

# Backend the dev-server proxy forwards /api/ and the reset-password pages to.
# Read by vite.config.js (not exposed to the browser). Defaults to http://localhost:3000.
# VITE_PROXY_TARGET=http://localhost:3000

# Development Only Variables (ignored in production builds, which always use "/api/")
# Only VITE_-prefixed variables are exposed to the client code (import.meta.env.VITE_*).
# (Renamed from REACT_APP_API_URL / REACT_APP_MOBILE_API_URL when moving from CRA to Vite.)

# Full API base URL used by desktop browsers during development.
# Leave empty to use the dev-server proxy ("/api/"), which keeps cookies same-origin.
VITE_API_URL="http://localhost:3000/api/"

# Full API base URL used when the dev site is opened on a phone/tablet on the same network.
# Must be reachable from the device, i.e. your machine's LAN IP, including protocol, port and /api/ path:
#   VITE_MOBILE_API_URL="http://192.168.1.10:3000/api/"
# If left unset, VITE_API_URL is used instead.
VITE_MOBILE_API_URL=
